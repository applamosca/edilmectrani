{
  "mcpServers": {
    "cloudflare": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp/cloudflare/server.js"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      }
    },
    "ionos": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp/ionos/server.js"],
      "env": {
        "IONOS_API_KEY": "${IONOS_API_KEY}"
      }
    }
  }
}
